---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/layout/PageHeader.astro";
import CertTable from "@components/certs/CertTable.astro";
import { getSortedCerts } from "@lib/collections";

const certs = await getSortedCerts();
---

<BaseLayout
  title="Verified Credentials & Certifications"
  description="Verified cloud and infrastructure certifications awarded by Oracle, GitHub, and Atlassian."
>
  <div class="space-y-10">
    <PageHeader
      eyebrow="CREDENTIALS LEDGER"
      title="Verified Certifications & Accreditations"
      description="Externally verifiable credentials across cloud platforms, declarative infrastructure, and continuous delivery systems."
    />

    <CertTable certs={certs} />
  </div>
</BaseLayout>
