---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/layout/PageHeader.astro";
import Portrait from "@components/common/Portrait.astro";
import AcademicRow from "@components/about/AcademicRow.astro";
import SkillCard from "@components/about/SkillCard.astro";
import { buildProfileSchema } from "@lib/schemas";
import skills from "@data/competencies.json";
import publicationItems from "@data/publications.json";

const aboutURL = new URL("/about", Astro.site ?? Astro.url.origin).href;
const profileSchema = buildProfileSchema({
    profileUrl: aboutURL,
    name: "Satya Tulasi Jalandhar C H",
    jobTitle: "Cloud & DevOps Engineer",
    sameAs: [
        "https://www.linkedin.com/in/satyatulasijalandharch",
        "https://github.com/satyatulasijalandharch",
    ],
    knowsAbout: skills.map((skill) => skill.title),
});
---

<BaseLayout
    title="About — Satya Tulasi Jalandhar C H"
    description="Background, career timeline, operating principles, and engineering philosophy of Satya Tulasi Jalandhar C H."
    jsonLd={profileSchema}
>
    <div class="space-y-10 sm:space-y-12">
        <PageHeader
            eyebrow="BACKGROUND & PHILOSOPHY"
            title="Satya Tulasi Jalandhar C H"
            description="Cloud & DevOps Engineer with 2+ years of hands-on experience designing and operating multi-cloud infrastructure across AWS, OCI, and modern web platforms."
        />

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 items-start">
            <div class="sm:col-span-1">
                <Portrait class="w-full p-2" width={300} height={300} />
            </div>

            <div
                class="sm:col-span-2 space-y-4 text-sm text-text-secondary leading-relaxed"
            >
                <h2 class="text-lg font-semibold text-text-primary">
                    Engineering Philosophy
                </h2>
                <p>
                    I approach cloud infrastructure with the principles of
                    International Typographic Style: simplicity, structural
                    clarity, zero unnecessary bloat, and total transparency.
                </p>
                <p>
                    Rather than introducing heavyweight orchestration for modest
                    workloads, I prioritize right-sizing, deterministic
                    Infrastructure as Code (Terraform &amp; AWS CDK), and
                    automated CI/CD safeguards that eliminate human error.
                </p>
            </div>
        </div>

        <section class="space-y-6 pt-6 border-t border-border">
            <h2 class="text-xl font-semibold tracking-tight text-text-primary">
                Core Technical Competencies
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                {
                    skills.map((skill) => (
                        <SkillCard title={skill.title}>
                            {skill.description}
                        </SkillCard>
                    ))
                }
            </div>
        </section>

        <section class="space-y-4 pt-6 border-t border-border text-sm">
            <h2 class="text-xl font-semibold tracking-tight text-text-primary">
                Research &amp; Publications
            </h2>
            <div class="space-y-3">
                {
                    publicationItems.map((item, index) => (
                        <div
                            class={
                                index < publicationItems.length - 1
                                    ? "border-b border-border pb-3"
                                    : ""
                            }
                        >
                            <AcademicRow title={item.title} date={item.date}>
                                {item.description}
                                {item.url && (
                                    <>
                                        {" "}
                                        <a
                                            href={item.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="font-medium text-text-primary underline underline-offset-2"
                                        >
                                            View publication
                                        </a>
                                    </>
                                )}
                            </AcademicRow>
                        </div>
                    ))
                }
            </div>
        </section>
    </div>
</BaseLayout>
