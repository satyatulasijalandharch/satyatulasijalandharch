---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import Callout from "@components/mdx/Callout.astro";
import MetricStat from "@components/mdx/MetricStat.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) => !data.draft);
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post },
    }));
}

const { id } = Astro.params;
const post = Astro.props.post ?? (id ? await getEntry("blog", id) : undefined);

if (!post) {
    return Astro.redirect("/404");
}

const { Content } = await render(post);

const formattedDate = new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
}).format(post.data.pubDate);
---

<BaseLayout
    title={`${post.data.title} — Engineering Notes`}
    description={post.data.description}
>
    <article class="max-w-3xl mx-auto space-y-8">
        <header class="border-b border-border pb-6 space-y-3">
            <div
                class="flex items-center justify-between text-xs text-text-muted tabular-nums"
            >
                <span>{post.data.topic}</span>
                <div class="flex items-center gap-2">
                    <time datetime={post.data.pubDate.toISOString()}
                        >{formattedDate}</time
                    >
                    <span>&bull;</span>
                    <span>{post.data.readTime}</span>
                </div>
            </div>

            <h1
                class="text-2xl sm:text-4xl font-semibold tracking-tight text-text-primary"
            >
                {post.data.title}
            </h1>

            <p class="text-base text-text-secondary leading-relaxed">
                {post.data.description}
            </p>
        </header>

        <div
            class="prose prose-neutral dark:prose-invert max-w-none text-text-secondary leading-relaxed space-y-6 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-text-primary [&_h2]:pt-4 [&_p]:leading-relaxed [&_ol]:list-decimal [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1"
        >
            <Content components={{ Callout, MetricStat }} />
        </div>

        <footer
            class="pt-8 border-t border-border flex items-center justify-between text-sm"
        >
            <a
                href="/blog"
                class="text-text-secondary hover:text-text-primary transition-colors"
            >
                &larr; Back to all Articles
            </a>
        </footer>
    </article>
</BaseLayout>
