---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/layout/PageHeader.astro";
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import { formatDate } from "@lib/dates";
import { buildBlogPostSchema } from "@lib/schemas";

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) => !data.draft);
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post },
    }));
}

const { id } = Astro.params;
const post = Astro.props.post ?? (id ? await getEntry("blog", id) : undefined);

if (!post) {
    return Astro.redirect("/404");
}

const { Content } = await render(post);

const formattedDate = formatDate(post.data.pubDate);
const formattedUpdatedDate = post.data.updatedDate
    ? formatDate(post.data.updatedDate)
    : undefined;

const postURL = new URL(`/blog/${post.id}`, Astro.site ?? Astro.url.origin)
    .href;
const blogPostingSchema = buildBlogPostSchema({
    postUrl: postURL,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    updatedDate: post.data.updatedDate,
    topic: post.data.topic,
});
---

<BaseLayout
    title={`${post.data.title} — Engineering Notes`}
    description={post.data.description}
    article={true}
    publishedTime={post.data.pubDate}
    modifiedTime={post.data.updatedDate ?? undefined}
    articleSection={post.data.topic}
    jsonLd={blogPostingSchema}
>
    <article class="space-y-8">
        <PageHeader
            eyebrow={post.data.topic}
            title={post.data.title}
            description={post.data.description}
        >
            <div
                class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-text-muted tabular-nums pt-2"
            >
                <span>
                    Published
                    <time datetime={post.data.pubDate.toISOString()}>
                        {formattedDate}
                    </time>
                </span>
                {
                    post.data.updatedDate && formattedUpdatedDate && (
                        <span>
                            &bull; Updated
                            <time
                                datetime={post.data.updatedDate.toISOString()}
                            >
                                {formattedUpdatedDate}
                            </time>
                        </span>
                    )
                }
                <span>&bull;</span>
                <span>{post.data.readTime} read</span>
            </div>
        </PageHeader>

        {
            post.data.cover && (
                <div class="border border-border p-1 bg-surface-subtle">
                    <Image
                        src={post.data.cover}
                        alt={post.data.title}
                        class="w-full h-auto aspect-video object-cover"
                    />
                </div>
            )
        }

        <div
            class="prose prose-neutral dark:prose-invert max-w-none text-text-secondary leading-relaxed space-y-6 prose-headings:text-text-primary prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-text-primary prose-a:underline-offset-4 hover:prose-a:underline prose-code:text-text-primary prose-pre:border prose-pre:border-border prose-blockquote:border-border prose-blockquote:text-text-secondary prose-strong:text-text-primary"
        >
            <Content />
        </div>

        <footer
            class="pt-8 border-t border-border flex items-center justify-between text-sm"
        >
            <a
                href="/blog"
                class="text-text-secondary hover:text-text-primary transition-colors"
            >
                &larr; Back to all Articles
            </a>
        </footer>
    </article>
</BaseLayout>
