---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) => !data.draft);
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post },
    }));
}

const { id } = Astro.params;
const post = Astro.props.post ?? (id ? await getEntry("blog", id) : undefined);

if (!post) {
    return Astro.redirect("/404");
}

const { Content } = await render(post);

const formattedDate = new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
}).format(post.data.pubDate);

const formattedUpdatedDate = post.data.updatedDate
    ? new Intl.DateTimeFormat("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric",
      }).format(post.data.updatedDate)
    : undefined;

const postURL = new URL(`/blog/${post.id}`, Astro.site ?? Astro.url.origin)
    .href;
const blogPostingSchema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": `${postURL}#blogposting`,
    mainEntityOfPage: { "@type": "WebPage", "@id": postURL },
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    ...(post.data.updatedDate && {
        dateModified: post.data.updatedDate.toISOString(),
    }),
    articleSection: post.data.topic,
    inLanguage: "en",
};
---

<BaseLayout
    title={`${post.data.title} — Engineering Notes`}
    description={post.data.description}
    article={true}
    publishedTime={post.data.pubDate}
    modifiedTime={post.data.updatedDate ?? undefined}
    articleSection={post.data.topic}
    jsonLd={blogPostingSchema}
>
    <article class="max-w-3xl mx-auto space-y-8">
        <header class="border-b border-border pb-6 space-y-3">
            <div
                class="flex flex-col gap-1 text-xs text-text-muted tabular-nums sm:flex-row sm:items-center sm:justify-between"
            >
                <span>{post.data.topic}</span>
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span>
                        Published
                        <time datetime={post.data.pubDate.toISOString()}>
                            {formattedDate}
                        </time>
                    </span>
                    {
                        post.data.updatedDate && formattedUpdatedDate && (
                            <span>
                                Updated
                                <time
                                    datetime={post.data.updatedDate.toISOString()}
                                >
                                    {formattedUpdatedDate}
                                </time>
                            </span>
                        )
                    }
                    <span>{post.data.readTime} read</span>
                </div>
            </div>

            <h1
                class="text-2xl sm:text-4xl font-semibold tracking-tight text-text-primary"
            >
                {post.data.title}
            </h1>

            <p class="text-base text-text-secondary leading-relaxed">
                {post.data.description}
            </p>
        </header>

        <div
            class="prose prose-neutral dark:prose-invert max-w-none text-text-secondary leading-relaxed space-y-6 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-text-primary [&_h2]:pt-4 [&_p]:leading-relaxed [&_ol]:list-decimal [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1"
        >
            <Content />
        </div>

        <footer
            class="pt-8 border-t border-border flex items-center justify-between text-sm"
        >
            <a
                href="/blog"
                class="text-text-secondary hover:text-text-primary transition-colors"
            >
                &larr; Back to all Articles
            </a>
        </footer>
    </article>
</BaseLayout>
