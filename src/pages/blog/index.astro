---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/layout/PageHeader.astro";
import BlogPostRow from "@components/blog/BlogPostRow.astro";
import { getSortedPosts } from "@lib/collections";

const posts = await getSortedPosts();
---

<BaseLayout
    title="Blog & Engineering Notes"
    description="Technical notes and architecture postmortems on cloud cost optimization, serverless patterns, and container infrastructure."
>
    <div class="space-y-10">
        <PageHeader
            eyebrow="WRITING & ANALYSIS"
            title="Engineering Notes & Technical Articles"
            description="Reflections, architectural decisions, and operational lessons learned while running production workloads."
        />

        <div class="border-t border-border">
            <div
                class="hidden sm:grid sm:grid-cols-12 py-2 text-xs font-semibold uppercase tracking-wider text-text-muted border-b border-border tabular-nums"
            >
                <span class="sm:col-span-2">Date</span>
                <span class="sm:col-span-6">Title</span>
                <span class="sm:col-span-2">Topic</span>
                <span class="sm:col-span-2 text-right">Read Time</span>
            </div>

            {
                posts.length === 0 ? (
                    <div class="py-8 text-center text-text-muted text-sm border-b border-border">
                        No articles published yet.
                    </div>
                ) : (
                    posts.map((post) => <BlogPostRow post={post} />)
                )
            }
        </div>
    </div>
</BaseLayout>
