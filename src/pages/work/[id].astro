---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import Callout from "@components/mdx/Callout.astro";
import MetricStat from "@components/mdx/MetricStat.astro";
import ArchitectureFigure from "@components/mdx/ArchitectureFigure.astro";

export async function getStaticPaths() {
    const entries = await getCollection("work");
    return entries.map((entry) => ({
        params: { id: entry.id },
        props: { entry },
    }));
}

const { id } = Astro.params;
const entry =
    Astro.props.entry ?? (id ? await getEntry("work", id) : undefined);

if (!entry) {
    return Astro.redirect("/404");
}

const { Content } = await render(entry);
---

<BaseLayout
    title={`${entry.data.title} — Case Study`}
    description={entry.data.description}
>
    <article class="max-w-3xl mx-auto space-y-8">
        <header class="border-b border-border pb-6 space-y-3">
            <div
                class="flex items-center justify-between text-xs text-text-muted tabular-nums"
            >
                <span class="tracking-wider uppercase"
                    >CASE STUDY &bull; {entry.data.period}</span
                >
                <span>{entry.data.company}</span>
            </div>

            <h1
                class="text-2xl sm:text-4xl font-semibold tracking-tight text-text-primary"
            >
                {entry.data.title}
            </h1>

            <p class="text-base text-text-secondary leading-relaxed">
                {entry.data.description}
            </p>

            <div class="pt-3 flex flex-wrap gap-2 text-xs">
                {
                    entry.data.stack.map((item) => (
                        <span class="border border-border bg-surface-subtle px-2 py-0.5 text-text-secondary">
                            {item}
                        </span>
                    ))
                }
            </div>
        </header>

        <div
            class="prose prose-neutral max-w-none text-text-secondary leading-relaxed space-y-6 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-text-primary [&_h2]:pt-4 [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1"
        >
            <Content components={{ Callout, MetricStat, ArchitectureFigure }} />
        </div>

        <footer
            class="pt-8 border-t border-border flex items-center justify-between text-sm"
        >
            <a
                href="/work"
                class="text-text-secondary hover:text-text-primary transition-colors"
            >
                &larr; Back to all Case Studies
            </a>
        </footer>
    </article>
</BaseLayout>
