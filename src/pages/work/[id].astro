---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
    const entries = await getCollection("work");
    return entries.map((entry) => ({
        params: { id: entry.id },
        props: { entry },
    }));
}

const { id } = Astro.params;
const entry =
    Astro.props.entry ?? (id ? await getEntry("work", id) : undefined);

if (!entry) {
    return Astro.redirect("/404");
}

const { Content } = await render(entry);

const caseStudyURL = new URL(
    `/work/${entry.id}`,
    Astro.site ?? Astro.url.origin,
).href;
const caseStudySchema = {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "@id": `${caseStudyURL}#case-study`,
    url: caseStudyURL,
    name: entry.data.title,
    description: entry.data.description,
    keywords: entry.data.stack,
    temporalCoverage: entry.data.period,
};
---

<BaseLayout
    title={`${entry.data.title} — Case Study`}
    description={entry.data.description}
    article={true}
    articleSection="Case Study"
    jsonLd={caseStudySchema}
>
    <article class="max-w-3xl mx-auto space-y-8">
        <header class="border-b border-border pb-6 space-y-3">
            <div class="text-xs text-text-muted tabular-nums">
                <span class="tracking-wider uppercase">
                    CASE STUDY &bull; {entry.data.period}
                </span>
            </div>

            <h1
                class="text-2xl sm:text-4xl font-semibold tracking-tight text-text-primary"
            >
                {entry.data.title}
            </h1>

            <p class="text-base text-text-secondary leading-relaxed">
                {entry.data.description}
            </p>

            <dl
                class="grid grid-cols-2 gap-x-4 gap-y-3 border-y border-border py-4 text-xs sm:grid-cols-3"
            >
                <div>
                    <dt class="text-text-muted uppercase tracking-wider">
                        Company
                    </dt>
                    <dd class="mt-1 font-medium text-text-primary">
                        {entry.data.company}
                    </dd>
                </div>
                <div>
                    <dt class="text-text-muted uppercase tracking-wider">
                        Role
                    </dt>
                    <dd class="mt-1 font-medium text-text-primary">
                        {entry.data.role}
                    </dd>
                </div>
                <div>
                    <dt class="text-text-muted uppercase tracking-wider">
                        Key result
                    </dt>
                    <dd class="mt-1 font-medium text-text-primary">
                        {entry.data.metric}
                    </dd>
                </div>
            </dl>

            <div class="pt-3 flex flex-wrap gap-2 text-xs">
                {
                    entry.data.stack.map((item) => (
                        <span class="border border-border bg-surface-subtle px-2 py-0.5 text-text-secondary">
                            {item}
                        </span>
                    ))
                }
            </div>
        </header>

        <div
            class="prose prose-neutral dark:prose-invert max-w-none text-text-secondary leading-relaxed space-y-6 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-text-primary [&_h2]:pt-4 [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1"
        >
            <Content />
        </div>

        <footer
            class="pt-8 border-t border-border flex items-center justify-between text-sm"
        >
            <a
                href="/work"
                class="text-text-secondary hover:text-text-primary transition-colors"
            >
                &larr; Back to all Case Studies
            </a>
        </footer>
    </article>
</BaseLayout>
