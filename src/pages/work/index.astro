---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/layout/PageHeader.astro";
import { getCollection } from "astro:content";
import ProjectCard from "@components/ProjectCard.astro";

const works = (await getCollection("work")).sort(
    (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
    title="Selected Work — Architecture & Case Studies"
    description="Detailed architectural breakdowns and production case studies in AWS platforms, Terraform, Docker, and zero-downtime CI/CD."
>
    <div class="space-y-10">
        <PageHeader
            eyebrow="ARCHITECTURAL DOSSIER"
            title="Selected Work & Case Studies"
            description="Production infrastructure deployments, FinOps automation engines, and reliable release pipelines designed and operated across AWS, OCI, and modern cloud platforms."
        />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
                works.length === 0 ? (
                    <div class="col-span-full border border-border p-8 text-center text-text-muted text-sm">
                        No case studies found.
                    </div>
                ) : (
                    works.map((item, index) => (
                        <ProjectCard work={item} index={index} />
                    ))
                )
            }
        </div>
    </div>
</BaseLayout>
