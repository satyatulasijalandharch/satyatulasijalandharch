---
import "../styles/global.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import ThemeProvider from "@components/theme/ThemeProvider.astro";
import SiteHeader from "@components/layout/SiteHeader.astro";
import SiteFooter from "@components/layout/SiteFooter.astro";
import Container from "@components/layout/Container.astro";
import defaultProfileImage from "@assets/images/profile.png";
import { serializeJsonLd, buildWebsiteSchema } from "@lib/schemas";

interface Props {
	title?: string;
	description?: string;
	image?: string | ImageMetadata;
	imageAlt?: string;
	canonicalURL?: string;
	article?: boolean;
	publishedTime?: Date;
	modifiedTime?: Date;
	articleSection?: string;
	jsonLd?: Record<string, unknown>;
	noindex?: boolean;
}

const siteOrigin = Astro.site ?? Astro.url.origin;
const siteURL = new URL("/", siteOrigin).href;
const siteName = "Satya Tulasi Jalandhar C H";

const {
	title = "Satya Tulasi Jalandhar C H — Cloud & DevOps Engineer",
	description = "Cloud & DevOps Engineer with 2+ years of experience designing and managing multi-cloud infrastructure across AWS, OCI, and Vercel. Expert in Terraform, AWS CDK, Docker, and CI/CD automation.",
	image = defaultProfileImage,
	imageAlt = "Portrait of Satya Tulasi Jalandhar C H",
	canonicalURL = new URL(Astro.url.pathname, siteOrigin).href,
	article = false,
	publishedTime,
	modifiedTime,
	articleSection,
	jsonLd,
	noindex = false,
} = Astro.props;

const siteTitle = title.includes("Satya Tulasi Jalandhar C H")
	? title
	: `${title} | Satya Tulasi Jalandhar C H`;

const resolvedImageSrc =
	typeof image === "string"
		? image
		: (
				await getImage({
					src: image,
					format: "webp",
					width: 1200,
					height: 630,
				})
			).src;

const ogImageUrl = new URL(resolvedImageSrc, siteOrigin).href;
const websiteJsonLd = serializeJsonLd(
	buildWebsiteSchema({ siteUrl: siteURL, siteName }),
);
const pageJsonLd = jsonLd ? serializeJsonLd(jsonLd) : undefined;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-background text-text-primary">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<title>{siteTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Satya Tulasi Jalandhar C H | Engineering Notes"
			href={new URL("rss.xml", Astro.site)}
		/>
		<link rel="sitemap" href="/sitemap.xml" />
		<script type="application/ld+json" set:html={websiteJsonLd} />
		{
			pageJsonLd && (
				<script type="application/ld+json" set:html={pageJsonLd} />
			)
		}

		<!-- Favicon & Touch Icons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<ThemeProvider />

		<!-- Open Graph / Meta -->
		<meta property="og:type" content={article ? "article" : "website"} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={siteTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		{
			article && publishedTime && (
				<meta
					property="article:published_time"
					content={publishedTime.toISOString()}
				/>
			)
		}
		{
			article && modifiedTime && (
				<meta
					property="article:modified_time"
					content={modifiedTime.toISOString()}
				/>
			)
		}
		{
			articleSection && (
				<meta property="article:section" content={articleSection} />
			)
		}

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={siteTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />
	</head>
	<body
		id="top"
		class="min-h-screen flex flex-col bg-background text-text-primary font-sans selection:bg-surface"
	>
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-100 focus:bg-background focus:px-4 focus:py-2 focus:text-text-primary"
		>
			Skip to main content
		</a>
		<SiteHeader />
		<Container class="flex-1 py-8 sm:py-12">
			<main id="main-content">
				<slot />
			</main>
		</Container>
		<SiteFooter />
	</body>
</html>
