---
import type { BlogEntry } from "@types";
import { formatMonthYear } from "@lib/dates";

interface Props {
    post: BlogEntry;
}

const { post } = Astro.props;
const dateStr = formatMonthYear(post.data.pubDate);
---

<article
    class="grid grid-cols-1 sm:grid-cols-12 py-4 border-b border-border text-sm gap-2 sm:gap-0 items-baseline"
>
    <span class="text-xs text-text-muted sm:col-span-2 tabular-nums">
        {dateStr}
    </span>
    <h2 class="sm:col-span-6 font-medium text-text-primary">
        <a href={`/blog/${post.id}`} class="hover:underline">
            {post.data.title}
        </a>
    </h2>
    <span class="text-xs text-text-secondary sm:col-span-2">
        {post.data.topic}
    </span>
    <span
        class="text-xs text-text-muted sm:col-span-2 sm:text-right tabular-nums"
    >
        {post.data.readTime} &rarr;
    </span>
</article>
