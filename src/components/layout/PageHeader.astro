---
interface Props {
    eyebrow?: string;
    title: string;
    description?: string;
    class?: string;
}

const { eyebrow, title, description, class: className = "" } = Astro.props;
---

<header class={`border-b border-border pb-6 sm:pb-8 space-y-3 ${className}`}>
    {
        eyebrow && (
            <div class="text-xs uppercase tracking-wider text-text-muted">
                {eyebrow}
            </div>
        )
    }
    <h1
        class="text-2xl sm:text-4xl font-semibold tracking-tight text-text-primary"
    >
        {title}
    </h1>
    {
        description && (
            <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
                {description}
            </p>
        )
    }
    <slot />
</header>
