---
import Container from "./Container.astro";
import ResumeButton from "@components/ResumeButton.astro";
import ThemeToggle from "@components/ThemeToggle.astro";

const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { label: "Home", href: "/" },
  { label: "Work", href: "/work" },
  { label: "Blog", href: "/blog" },
  { label: "Certs", href: "/certs" },
  { label: "About", href: "/about" },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur-md transition-colors"
>
  <Container class="py-2.5 sm:py-4">
    <nav
      class="flex flex-wrap items-center justify-between gap-y-2 text-[13px] sm:text-sm w-full"
      aria-label="Main Navigation"
    >
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="primary-navigation"
        class="order-1 inline-flex h-8 w-8 items-center justify-center rounded-md border border-border bg-surface-subtle text-text-secondary transition-colors hover:bg-surface hover:text-text-primary md:hidden"
      >
        <svg
          data-menu-open-icon
          class="h-4 w-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          data-menu-close-icon
          class="hidden h-4 w-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="m18 6-12 12M6 6l12 12"></path>
        </svg>
      </button>

      <div
        id="primary-navigation"
        class="order-3 hidden w-full flex-col gap-1 border-t border-border pt-2 md:order-1 md:flex md:w-auto md:flex-row md:items-center md:gap-8 md:border-0 md:pt-0"
      >
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={`py-2 transition-colors tracking-tight whitespace-nowrap md:py-1 ${
                isActive(item.href)
                  ? "text-text-primary font-medium underline underline-offset-4 decoration-border"
                  : "text-text-secondary hover:text-text-primary"
              }`}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <div class="order-2 ml-auto flex shrink-0 items-center gap-2 md:ml-0">
        <ThemeToggle />
        <ResumeButton variant="pill" />
      </div>
    </nav>
  </Container>
</header>

<script>
  function setupMobileMenu() {
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("primary-navigation");
    if (!toggle || !menu || toggle.dataset.initialized) return;
    toggle.dataset.initialized = "true";

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        `${open ? "Close" : "Open"} navigation menu`,
      );
      menu.classList.toggle("hidden", !open);
      menu.classList.toggle("flex", open);
      toggle
        .querySelector("[data-menu-open-icon]")
        ?.classList.toggle("hidden", open);
      toggle
        .querySelector("[data-menu-close-icon]")
        ?.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    menu.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setOpen(false);
    });
    toggle.parentElement?.addEventListener("keydown", (event) => {
      if (
        event.key !== "Escape" ||
        toggle.getAttribute("aria-expanded") !== "true"
      )
        return;
      setOpen(false);
      toggle.focus();
    });
  }

  setupMobileMenu();
  document.addEventListener("astro:after-swap", setupMobileMenu);
</script>
