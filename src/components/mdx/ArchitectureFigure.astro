---
interface Props {
    caption?: string;
    number?: string;
    class?: string;
}

const { caption, number, class: className = "" } = Astro.props;
---

<figure
    class={`my-8 border border-border bg-surface-subtle p-3 sm:p-5 ${className}`}
>
    <div class="overflow-x-auto flex justify-center py-2">
        <slot />
    </div>
    {
        caption && (
            <figcaption class="mt-3 pt-3 border-t border-border flex items-center justify-between text-xs text-text-muted">
                <span class="tracking-tight">{caption}</span>
                {number && (
                    <span class="tabular-nums font-medium text-text-secondary">
                        {number}
                    </span>
                )}
            </figcaption>
        )
    }
</figure>
