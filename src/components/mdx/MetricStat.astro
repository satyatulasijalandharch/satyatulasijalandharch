---
interface Props {
    value: string;
    label: string;
    detail?: string;
    class?: string;
}

const { value, label, detail, class: className = "" } = Astro.props;
---

<div
    class={`my-6 border border-border bg-background p-4 sm:p-5 flex flex-col justify-between ${className}`}
>
    <div
        class="text-xs uppercase tracking-wider text-text-muted font-medium mb-1"
    >
        {label}
    </div>
    <div
        class="text-2xl sm:text-3xl font-semibold tracking-tight text-text-primary tabular-nums"
    >
        {value}
    </div>
    {
        detail && (
            <div class="text-xs text-text-secondary mt-2 pt-2 border-t border-border">
                {detail}
            </div>
        )
    }
</div>
