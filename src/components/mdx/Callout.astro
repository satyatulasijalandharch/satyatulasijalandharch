---
interface Props {
    type?: "info" | "warning" | "note";
    title?: string;
    class?: string;
}

const { type = "note", title, class: className = "" } = Astro.props;

const typeLabel =
    title ||
    (type === "warning"
        ? "ATTENTION"
        : type === "info"
          ? "OBSERVATION"
          : "NOTE");
---

<aside
    class={`my-6 border border-border bg-surface/50 p-4 sm:p-5 text-sm text-text-primary ${className}`}
    role="note"
>
    <div
        class="flex items-center gap-2 mb-2 text-xs font-semibold tracking-wider text-text-secondary uppercase tabular-nums"
    >
        <span class="inline-block w-1.5 h-1.5 bg-text-secondary"></span>
        <span>{typeLabel}</span>
    </div>
    <div class="text-text-secondary text-sm leading-relaxed space-y-2">
        <slot />
    </div>
</aside>
