---
interface Props {
    title: string;
}

const { title } = Astro.props as Props;
---

<div class="border border-border p-4 bg-background space-y-2">
    <h3 class="font-semibold text-text-primary uppercase tracking-wider">
        {title}
    </h3>
    <div class="text-text-secondary">
        <slot />
    </div>
</div>
