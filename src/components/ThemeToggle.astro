---

---

<button
    id="theme-toggle"
    type="button"
    aria-label="Theme: system default. Click to switch to light theme."
    title="Theme: Auto (System)"
    class="inline-flex items-center justify-center w-8 h-8 rounded-md border border-border bg-surface-subtle hover:bg-surface transition-colors text-text-secondary hover:text-text-primary"
>
    <!-- Auto/System: Monitor icon -->
    <svg
        id="icon-auto"
        class="w-4 h-4 hidden"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
    >
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
        <line x1="8" y1="21" x2="16" y2="21"></line>
        <line x1="12" y1="17" x2="12" y2="21"></line>
    </svg>

    <!-- Sun: visible when light mode is selected -->
    <svg
        id="icon-sun"
        class="w-4 h-4 hidden"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
    >
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>

    <!-- Moon: visible when dark mode is selected -->
    <svg
        id="icon-moon"
        class="w-4 h-4 hidden"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
    >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
</button>

<style>
    :global(html[data-theme="auto"] #icon-auto),
    :global(html:not([data-theme]) #icon-auto) {
        display: block;
    }
    :global(html[data-theme="light"] #icon-sun) {
        display: block;
    }
    :global(html[data-theme="dark"] #icon-moon) {
        display: block;
    }
</style>

<script>
    function setupThemeToggle() {
        const button = document.getElementById("theme-toggle");
        if (!button) return;

        const descriptions: Record<string, { label: string; title: string }> = {
            auto: {
                label: "Theme: system default. Click to switch to light theme.",
                title: "Theme: Auto (System)",
            },
            light: {
                label: "Theme: light. Click to switch to dark theme.",
                title: "Theme: Light",
            },
            dark: {
                label: "Theme: dark. Click to switch to system default theme.",
                title: "Theme: Dark",
            },
        };

        function updateAccessibility(theme: string) {
            const info = descriptions[theme] || descriptions.auto;
            button?.setAttribute("aria-label", info.label);
            button?.setAttribute("title", info.title);
        }

        const currentTheme =
            document.documentElement.getAttribute("data-theme") || "auto";
        updateAccessibility(currentTheme);

        window.addEventListener("theme-change", ((e: CustomEvent) => {
            if (e.detail?.theme) {
                updateAccessibility(e.detail.theme);
            }
        }) as EventListener);

        button.addEventListener("click", () => {
            const active =
                document.documentElement.getAttribute("data-theme") || "auto";
            const next =
                active === "auto"
                    ? "light"
                    : active === "light"
                      ? "dark"
                      : "auto";
            if (typeof (window as any).setTheme === "function") {
                (window as any).setTheme(next);
            }
        });
    }

    setupThemeToggle();
    document.addEventListener("astro:after-swap", setupThemeToggle);
</script>
