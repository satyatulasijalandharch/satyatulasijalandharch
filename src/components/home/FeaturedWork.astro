---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "@components/ProjectCard.astro";

interface Props {
    works: CollectionEntry<"work">[];
}

const { works } = Astro.props;
---

<section class="space-y-6">
    <div class="flex items-center justify-between border-b border-border pb-3">
        <h2 class="text-xs uppercase tracking-wider text-text-muted">
            SELECTED WORK
        </h2>
        <a
            href="/work"
            class="text-xs font-medium text-text-primary hover:underline"
        >
            View All ({works.length}) &rarr;
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {works.map((item, index) => <ProjectCard work={item} index={index} />)}
    </div>
</section>
