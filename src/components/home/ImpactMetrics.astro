---
import MetricItem from "./MetricItem.astro";

const metrics = [
    {
        label: "01. INFRASTRUCTURE AS CODE",
        value: "-50% Errors",
        description: "Modular Multi-Environment AWS CDK v2 & Terraform",
    },
    {
        label: "02. HIGH AVAILABILITY",
        value: "99.9% Uptime",
        description: "Zero-Downtime CI/CD & Clustering Across 15+ Services",
    },
    {
        label: "03. DATABASE COST OPTIMIZATION",
        value: "-30% Spend",
        description: "DynamoDB (PITR/GSIs) & Aurora Serverless v2 Storage",
    },
];
---

<section
    aria-labelledby="impact-metrics-heading"
    class="pt-6 border-t border-border grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 divide-y sm:divide-y-0 divide-border"
>
    <h2 id="impact-metrics-heading" class="sr-only">Impact metrics</h2>
    {
        metrics.map((item) => (
            <MetricItem
                label={item.label}
                value={item.value}
                description={item.description}
            />
        ))
    }
</section>
