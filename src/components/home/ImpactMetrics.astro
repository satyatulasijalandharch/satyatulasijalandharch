---
import MetricItem from "./MetricItem.astro";

const metrics = [
    {
        label: "01. COST OPTIMIZATION",
        value: "-40% Spend",
        description: "Automated FinOps & Workload Rightsizing",
    },
    {
        label: "02. DEPLOYMENT VELOCITY",
        value: "<10 Min",
        description: "Zero-Downtime Multi-Region Pipeline",
    },
    {
        label: "03. INFRASTRUCTURE AS CODE",
        value: "100% Declarative",
        description: "Deterministic Terraform & AWS CDK",
    },
];
---

<section
    aria-labelledby="impact-metrics-heading"
    class="pt-6 border-t border-border grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 divide-y sm:divide-y-0 divide-border"
>
    <h2 id="impact-metrics-heading" class="sr-only">Impact metrics</h2>
    {
        metrics.map((item) => (
            <MetricItem
                label={item.label}
                value={item.value}
                description={item.description}
            />
        ))
    }
</section>
