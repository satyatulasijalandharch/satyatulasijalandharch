---
import type { ExperienceEntry } from "@types";
import ResumeButton from "@components/common/ResumeButton.astro";

interface Props {
    experience: ExperienceEntry[];
}

const { experience } = Astro.props;
---

<section class="space-y-6">
    <div class="flex items-center justify-between border-b border-border pb-3">
        <h2 class="text-xs uppercase tracking-wider text-text-muted">
            EXPERIENCE &amp; CAREER TIMELINE
        </h2>
        <ResumeButton label="Full Resume" variant="link" />
    </div>

    <div class="border-t border-border">
        {
            experience.map((exp) => (
                <article class="grid grid-cols-1 md:grid-cols-12 py-5 border-b border-border text-sm gap-2 md:gap-4 items-baseline">
                    <span class="md:col-span-2 text-xs text-text-muted tabular-nums font-medium">
                        {exp.data.period}
                    </span>
                    <div class="md:col-span-4">
                        <h3 class="font-semibold text-text-primary">
                            {exp.data.role}
                        </h3>
                        <div class="text-xs text-text-secondary">
                            {exp.data.company}
                        </div>
                    </div>
                    <div class="md:col-span-6 space-y-1.5">
                        <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
                            {exp.data.focus}
                        </p>
                        <div class="text-xs text-text-muted">
                            Stack: {exp.data.stack.join(" · ")}
                        </div>
                    </div>
                </article>
            ))
        }
    </div>
</section>
