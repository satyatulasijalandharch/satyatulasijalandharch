---
import type { CollectionEntry } from "astro:content";

interface Props {
  cert: CollectionEntry<"certs">;
}

const { cert } = Astro.props;
---

<article
  class="grid grid-cols-1 gap-2 border-b border-border py-4 text-sm sm:grid-cols-12 sm:items-center sm:gap-0"
>
  <div class="order-1 sm:order-0 sm:col-start-3 sm:col-span-6">
    <h2 class="font-medium text-text-primary text-sm sm:text-base">
      {cert.data.name}
    </h2>
    {
      cert.data.skills && (
        <p class="pt-1 text-xs leading-relaxed text-text-muted">
          {cert.data.skills.join(" · ")}
        </p>
      )
    }
  </div>
  <span
    class="order-2 text-xs text-text-secondary sm:order-0 sm:col-start-9 sm:col-span-2 sm:row-start-1 sm:self-center sm:text-sm"
  >
    {cert.data.issuer}
  </span>
  <div class="order-3 flex items-center justify-between sm:contents">
    <span
      class="text-xs text-text-muted tabular-nums sm:col-start-1 sm:col-span-2 sm:row-start-1 sm:self-center"
    >
      {cert.data.issueDate}
    </span>
    <div
      class="sm:col-start-11 sm:col-span-2 sm:row-start-1 sm:self-center sm:justify-self-end"
    >
      <a
        href={cert.data.credentialUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-medium text-text-primary hover:underline inline-flex items-center gap-1"
        aria-label={`Verify ${cert.data.name}`}
      >
        <span>Verify</span>
        <span aria-hidden="true" class="text-[10px]"> ↗ </span>
      </a>
    </div>
  </div>
</article>
