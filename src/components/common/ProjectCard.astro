---
import type { WorkEntry } from "@types";

interface Props {
	work: WorkEntry;
	index?: number;
}

const { work, index } = Astro.props;
---

<article
	class="border border-border bg-background p-5 flex flex-col justify-between hover:border-text-secondary transition-colors"
>
	<div class="space-y-3">
		<div
			class="flex items-center justify-between text-xs text-text-muted tabular-nums"
		>
			<span>
				{typeof index === "number" ? `0${index + 1}. ` : ""}CASE STUDY
			</span>
			<span>{work.data.company}</span>
		</div>

		<h2
			class="text-base sm:text-lg font-semibold tracking-tight text-text-primary leading-snug"
		>
			<a href={`/work/${work.id}`} class="hover:underline">
				{work.data.title}
			</a>
		</h2>

		<div class="text-xs text-text-secondary tabular-nums font-medium">
			Metric:{" "}
			<span class="text-text-primary font-semibold">
				{work.data.metric}
			</span>
		</div>

		<div class="text-xs text-text-muted">
			Stack: {work.data.stack.join(" · ")}
		</div>

		<p class="text-xs sm:text-sm text-text-secondary leading-relaxed pt-1">
			{work.data.description}
		</p>
	</div>

	<div
		class="pt-5 mt-4 border-t border-border flex items-center justify-between text-xs"
	>
		<span class="text-text-muted tabular-nums">{work.data.period}</span>
		<a
			href={`/work/${work.id}`}
			class="font-medium text-text-primary hover:text-text-secondary transition-colors inline-flex items-center gap-1"
		>
			<span>Read Breakdown</span>
			<span aria-hidden="true">&rarr;</span>
		</a>
	</div>
</article>
